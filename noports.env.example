# NoPorts configuration for the Junos OS Evolved container.
#
# Copy to /var/extensions/noports/noports.env on the routing engine and pass
# it to docker with --env-file (see QUICKSTART.md). Restart the container
# after changing it:  docker restart noports

# Required: the atSign identifying this router (get atSigns at noports.com)
DEVICE_ATSIGN=@mydevice

# Required: atSign(s) allowed to connect to this router (comma-separated)
MANAGER_ATSIGN=@manager

# Required: device name clients use to reach this router: sshnp -d <name>
# (alphanumeric + underscore, max 36 chars)
DEVICE_NAME=junos_router_1

# Optional: atDirectory server. Default: root.atsign.org
# When management-plane ACLs restrict egress, send ALL atProtocol traffic
# to one host on port 443 (see "Restricted egress" in the README):
# ROOT_SERVER=proxy:proxy0001.atsign.org:443

# Optional: host:port pairs clients may reach via npt (comma-separated).
# Default: localhost:22. Add localhost:830 to tunnel NETCONF.
# PERMIT_OPEN=localhost:22,localhost:830

# Optional: extra raw sshnpd flags, e.g. --sshpublickey
# SSHNPD_EXTRA_ARGS=
